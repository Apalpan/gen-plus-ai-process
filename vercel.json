{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": [
    "iad1"
  ],
  "functions": {
    "api/entry.mjs": {
      "maxDuration": 60,
      "includeFiles": "intelligence/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:rest*",
      "destination": "/api/entry?__path=:rest*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
